# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
POSTGRES_DB=security_gateway
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gateway_user:your_secure_database_password_here@localhost:5432/security_gateway

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM Provider Configuration
# =============================================================================
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_TIMEOUT_SECONDS=30

# =============================================================================
# Role-Based Access Control (RBAC) Allowlists
# =============================================================================
ADMIN_ALLOWED_MODELS=mock-model,gpt-4o-mini,gpt-4,gpt-4o,claude-3-5-sonnet-latest,claude-3-haiku-20240307
ANALYST_ALLOWED_MODELS=mock-model,gpt-4o-mini,claude-3-5-sonnet-latest
DEVELOPER_ALLOWED_MODELS=mock-model

# =============================================================================
# Redis Semantic Caching
# =============================================================================
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=300

# =============================================================================
# Enterprise Observability & OpenTelemetry (Optional)
# =============================================================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-llm-security-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# =============================================================================
# Automated Campaign Scheduling & SOC Alerting (Step 17)
# =============================================================================
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=30
SCHEDULER_MAX_CONCURRENT_CAMPAIGNS=2
SECURITY_SCORE_ALERT_THRESHOLD=-5.0

